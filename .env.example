# ============================================================
# 环境变量示例 —— 复制为 .env 后填写你自己的值
# 注意：.env 已被 .gitignore 排除，请勿提交
# ============================================================

# ---- QQ 机器人凭证（QQ 开放平台 → 你的应用）----
QQ_APP_ID=YOUR_APP_ID
QQ_APP_SECRET=YOUR_APP_SECRET

# ---- 模型服务凭证 ----
# 变量名需与 cordis.patch.yml 中 provider 的 apiKeyEnv 一致
AMD_API_KEY=YOUR_MODEL_API_KEY

# ---- 可选：上游地址（不使用本地转发层时直接填这里）----
# UPSTREAM_BASE_URL=https://your-upstream.example.com/v1

# ---- 可选：运行目录 ----
DSH_HOME=D:\dsh-env\dsh-home
